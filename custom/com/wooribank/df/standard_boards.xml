				<key_query dataSource="db_conn1" cursor_use="no">
					<![CDATA[
SELECT  id AS docid
FROM standard.hokkaido_board
WHERE id=1
					]]>
				</key_query>
				
				<key_inc_query dataSource="db_conn1">
					<![CDATA[
SELECT
		Q_ID AS q_id
		, MessageID AS docid -- 메시지ID
		, FolderID AS folder_id -- 폴더ID
		, CASE
			WHEN QueueType = 'I' THEN 'I'
			WHEN QueueType = 'U' THEN 'I'
			WHEN QueueType = 'D' THEN 'D'
			ELSE '' END AS indexAction__
FROM
		queue_searchdata_board_doc
WHERE
		IndexDate IS NULL
	and ServiceType = 'Board'
ORDER BY
		Q_ID ASC
					]]>
				</key_inc_query>
				
				<update_queue_query dataSource="db_conn1">
					<![CDATA[
UPDATE
		queue_searchdata_board_doc
SET
		IndexDate = now()
WHERE
		Q_ID = :q_id
					]]>
				</update_queue_query>
				
				<data_query dataSource="db_conn1">
					<![CDATA[
SELECT  id
	 , '20000' AS collapse_cd
	 , id AS docid
     , title
     , content
     , author AS writer_nm
     , department
     , category
--      , DATE_FORMAT(created_at, '%Y-%m-%dT%H:%i:%s') AS reg_dtm -- 등록일
     , DATE_FORMAT(created_at, '%Y-%m-%d') AS reg_dtm -- 등록일
     , DATE_FORMAT(updated_at, '%Y-%m-%d') AS upd_dtm -- 등록일
FROM standard.hokkaido_board
WHERE
		id = :docid
					]]>
