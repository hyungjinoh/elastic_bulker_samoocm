		<data_source last_doc_indexdate="2026-07-22 10:31:35" delete_not_indexed="yes">
			<query_info>
				<key_query dataSource="db_conn1" cursor_use="no">
					<![CDATA[
SELECT
	indexidkey AS docid
FROM covi_smart4j.ypmember
where ypmember.indexidkey <=5
					]]>
				</key_query>
				
				<key_inc_query dataSource="db_conn1">
					<![CDATA[
SELECT
		Q_ID AS q_id
		, MessageID AS docid -- 메시지ID
		, FolderID AS folder_id -- 폴더ID
		, CASE
			WHEN QueueType = 'I' THEN 'I'
			WHEN QueueType = 'U' THEN 'I'
			WHEN QueueType = 'D' THEN 'D'
			ELSE '' END AS indexAction__
FROM
		queue_searchdata_board_doc
WHERE
		IndexDate IS NULL
	and ServiceType = 'Board'
ORDER BY
		Q_ID ASC
					]]>
				</key_inc_query>
				
				<update_queue_query dataSource="db_conn1">
					<![CDATA[
UPDATE
		queue_searchdata_board_doc
SET
		IndexDate = now()
WHERE
		Q_ID = :q_id
					]]>
				</update_queue_query>
				
				<data_query dataSource="db_conn1">
					<![CDATA[
SELECT
	indexidkey AS docid,
	`NAME`,
	`EnglishName`
FROM covi_smart4j.ypmember
WHERE
	indexidkey=:docid
					]]>
				</data_query>
				
